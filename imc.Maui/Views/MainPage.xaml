<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="imc.Maui.Views.MainPage"
             Title="Indice de masa corporal">
    <ScrollView>
        <VerticalStackLayout
         Padding="24"
         Spacing="24">
         <Border 
          Stroke="LightGray" 
          StrokeThickness="2">
          <VerticalStackLayout 
            Padding="18"
            Spacing="8">
           <Label 
            Text="proporcione el peso en kilogramos:"/>
           <Entry
            BackgroundColor="WhiteSmoke"
            x:Name="PesoENtry"
               TextColor="Black"/>
           <Label 
            Text="proporcione la estatura en metros"/>
           <Entry 
            BackgroundColor="WhiteSmoke"
               TextColor="Black"
               x:Name="EstaturaEntry"/>
          </VerticalStackLayout>
         </Border>
         <HorizontalStackLayout 
           Spacing="24" 
           HorizontalOptions="Center">
          <Button 
           Text="calcular" 
           BackgroundColor="Green"
           Clicked="OnCalcularButtonClicked"/>
          <Button 
           Text="limpiar"
           Clicked="OnLimpiarButtonClicked"/>
         </HorizontalStackLayout>
         <Border 
          Stroke="LightGray" 
          StrokeThickness="2">
             
          <Border.StrokeShape>
            <RoundRectangle 
             CornerRadius="10"/>
          </Border.StrokeShape>
             
          <VerticalStackLayout  
           Padding="18" 
           Spacing="18">
           <Label 
            Text=" el indice de masa corporal es:"/>
           <Label 
            x:Name="ImcLabel"
            Text="23.4567" 
            HorizontalOptions="Center" 
            FontSize="Medium" 
            FontAttributes="Bold"/>
           <Label 
                Text="la situacion nutricional de la persona es:"/>
           <Label
            x:Name="SitucionNutricionalLabel"
            Text="peso normal" 
            HorizontalOptions="Center" 
            FontSize="Medium" 
            FontAttributes="Bold"/>
          </VerticalStackLayout>
         </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>